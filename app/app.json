{
  "expo": {
    "name": "Katuvit",
    "slug": "katuvit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "katuvit",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.katuvit.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "כדי לבחור סרטון מהגלריה ולהוסיף לו כתוביות",
        "NSPhotoLibraryAddUsageDescription": "כדי לשמור את הסרטון עם הכתוביות לגלריה שלך",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "he",
        "CFBundleLocalizations": [
          "he",
          "en"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E17",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.katuvit.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E17",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-video",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "כדי לבחור סרטון מהגלריה ולהוסיף לו כתוביות"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "כדי לשמור סרטונים לגלריה",
          "savePhotosPermission": "כדי לשמור את הסרטון עם הכתוביות לגלריה שלך",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0E17"
  }
}
